VNAA-Proposal.pdf

# Paper source is versioned here and synced manually with Overleaf.
# Ignore only local LaTeX build products and redundant rendered previews.
/paper/.build/
/paper/*.aux
/paper/*.bbl
/paper/*.blg
/paper/*.fdb_latexmk
/paper/*.fls
/paper/*.log
/paper/*.out
/paper/*.synctex.gz
/paper/*.toc
/paper/*.pdf
/paper/figures/*.png

