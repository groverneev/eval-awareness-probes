{
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.recipes": [
    {
      "name": "Build VNAA paper (Windows)",
      "tools": [
        "vnaa-build-windows"
      ]
    },
    {
      "name": "Build VNAA paper (macOS/Linux)",
      "tools": [
        "vnaa-build-unix"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "vnaa-build-windows",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "%DIR%/build.ps1",
        "-NoOpen"
      ]
    },
    {
      "name": "vnaa-build-unix",
      "command": "/bin/bash",
      "args": [
        "%DIR%/build.sh",
        "--no-open"
      ]
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab"
}
